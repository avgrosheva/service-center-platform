# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- Required — app refuses to start without these (Milestone 1) ---
# For local (non-docker) runs, point this at localhost.
# When running via docker-compose, the `app` service overrides this
# to use the `db` service hostname instead (see docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://fsp:dev_password_change_me@localhost:5432/field_service
JWT_SECRET=change-me-to-a-long-random-value

# --- Have defaults, override if needed ---
ENVIRONMENT=development
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=45
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# --- S3-compatible storage (Milestone 10) — MinIO via docker-compose for
# local dev; point at a real provider (AWS S3, Yandex Object Storage) in
# production. ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=field-service-platform

# --- AI layer (Milestone 18) — optional. AI_ENABLED=false (the default)
# means the /ai/* routes aren't registered at all; ANTHROPIC_API_KEY is
# only read once an AI task actually runs, so it's fine to leave unset
# while AI_ENABLED is false. ---
AI_ENABLED=false
# ANTHROPIC_API_KEY=
